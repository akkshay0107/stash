{
    "target": "terminus_exec",
    "cancel": "terminus_cancel_build",
    "focus": true,
    "shell_cmd": "g++ -std=c++23 -Wall \"$file\" -o a -fsanitize=address,undefined -g -D_GLIBCXX_DEBUG && ./a",
    "working_dir": "$file_path",
    "selector": "source.c++",
    "file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
    "panel_name": "Terminus"
}
